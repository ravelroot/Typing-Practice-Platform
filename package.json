{
  "name": "pluma",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-force-exit tests/unit/*.test.ts",
    "test:e2e": "node --test --test-force-exit --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "acervo": "java tools/Acervo.java web/data/textos.json web/data/palavras.json",
    "serve": "java tools/Servidor.java"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
